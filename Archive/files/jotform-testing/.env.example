# JotForm Testing - Environment Variables
# Copy this file to .env and update with your values

# JotForm Configuration
JOTFORM_URL=https://eel.jotform.com/252244495892972

# Email Configuration (for testing)
PCM_EMAIL=your.email@example.com
RD_EMAIL=your.email@example.com

# Browser Settings
HEADLESS_MODE=true
BROWSER_TIMEOUT=30000

# Workflow Settings
WORKFLOW_WAIT_TIME=10000
REDIRECT_TIMEOUT=3000

# Output Settings
OUTPUT_DIR=output
CREATE_TIMESTAMPED_FOLDERS=true

# Test Data
TEST_COMPANY_DIVISION=Edmundson Electrical
TEST_LOCATION_NUMBER=331
TEST_RAISED_BY=Automated Test
TEST_PAYMENT_TYPE=Sponsorship/Charitable Donation
TEST_PAYEE=Test Auto
TEST_VALUE=10000
